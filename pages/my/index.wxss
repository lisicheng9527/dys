/* pages/my/index.wxss */
.top-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 396rpx;
  z-index: -1;
}
.user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 30rpx 24rpx 30rpx 44rpx;
}
.user .fll {
  display: flex;
  align-items: center;
}
.user .avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-right: 10rpx;
}
.user .user-fr {
  height: 72rpx;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.user .user-fr .user-info {
  display: flex;
  align-items: center;
}
.user .user-fr .nickname {
  color: #000;
}
.user .user-fr .user-info .tag {
  border-radius: 4rpx;
  font-size: 24rpx;
  margin-left: 12rpx;
  padding: 2rpx 6rpx;
  /* display: flex;
  align-items: center; */
}
.user .user-fr .user-info .tag .iconfont {
  font-size: 30rpx;
}
.blue-tag {
  background: #A6CBE1;
}
.orange-tag {
  background: #EBBA81;
}
.yellow-tag {
  background: #EBCF81;
}
.pink-tag {
  background: #EB8183;
}
.user .user-fr .score {
  display: flex;
}
.user .user-fr .score .iconfont {
  font-size: 30rpx;
}
.user .user-fr .score view{
  margin-right: 20rpx;
}
.user .frr {
  font-size: 24rpx;
  color: #666;
}
.link {
  background: #FBF4EB;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
}
.link .tit {
  font-size: 32rpx;
  margin-bottom: 8rpx;
  display: flex;
  justify-content: space-between;
  position: relative;
}
.link .tit .hide-btn {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 24rpx;
  opacity: 0;
  z-index: 10;
}
.link .bless-img {
  display: block;
  width: 144rpx;
  margin: 0 auto;
}
.link .iconfont {

}
.link .con {
  font-size: 26rpx;
  color: #666;
}
.follow-modal .step-tip{
  background: #fff;
  width: 600rpx;
  border-radius: 120rpx;
  margin: 0 auto;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
}
.follow-modal .step-tip .step{
  font-size: 22rpx;
  background: #FBF4EB;
  border-radius: 80rpx;
  display: flex;
  flex-direction: column;
  padding: 12rpx 24rpx;
  position: relative;
  color: var(--themeColor);
}
.follow-modal .step-tip .step .num {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: #B94433;
  color: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  top: -7rpx;
  left: -7rpx;
}
.follow-modal .step-tip .next {
  display: flex;
  align-items: center;
}
.follow-modal .step-tip .next-1 {
  width: 28rpx;
  height: 8rpx;
  background: #FBF4EB;
}
.follow-modal .step-tip .next-2 {
  border-width: 20rpx;
  border-style: solid;
  border-color: transparent transparent transparent #FBF4EB;
}
.follow-modal .qrCode {
  width: 220rpx;
  height: 220rpx;
  background: #fff;
  margin: 36rpx auto 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 12rpx solid #B94433;
  border-radius: 16rpx;
}
.follow-modal .qrCode image {
  width: 100%;
}
.follow-modal .save-btn {
  width: 300rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  margin: 0 auto 24rpx;
}
.follow-modal .green {
  color: #42909D;
}
.follow-modal .tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--themeColor)
}
