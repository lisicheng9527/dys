/* pages/createBlessing/index.wxss */
.top .img {
  width: 252rpx;
  height: 252rpx;
  margin: 0 auto;
  background: #FEFFDD;
  border: 1px solid #FFF4C6;
  border-radius: 126rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top .img image {
  width: 132rpx;
}
.edit {
  padding: 0 24rpx;
}
.tit {
  line-height: 40rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.edit-box {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.edit-box input {
  width: 100%;
}
.edit-box textarea {
  word-wrap: break-word;
  white-space: pre-line;
  line-height: 36rpx;
  font-size: 26rpx;
  width: 100%;
}
.placeholder {
  color: #D5D5D5;
}
.imgs{
  display: flex;
}
.imgs .li {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  position: relative;
}
.imgs .li image {
  width: 100%;
  height: 100%;
}
.imgs .li .del {
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: rgba(0,0,0,0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.imgs .li .del text {
  font-size: 24rpx;
  font-weight: bold;
}
.upload-btn {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-btn .iconfont {
  color: #999;
  font-size: 48rpx;
}
.btn {
  position: fixed;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
}
.btn.dis {
  opacity: 0.5;
}