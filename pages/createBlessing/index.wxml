<!--创建祈福-->
<view >
  <view class="top top-bg">
    <view class="img">
      <image src="/image/bless.png" mode="aspectFit"/>
    </view>
  </view>
  <view class="edit">
    <view class="tit">许愿内容</view>
    <view class="edit-box">
      <input type="text" placeholder="标题：祝自己事业有成！" 	placeholder-class="placeholder" maxlength="20" value="{{title}}" bindinput="updateTitle"/>
    </view>
    <view class="edit-box">
      <textarea placeholder="补充许愿内容\n如：为2025年的自己许愿\n1、不再为租房发愁；\n2、工资涨得比物价快；\n3、顺利脱单，找个伴一起嗨；" value="{{content}}"  placeholder-class="placeholder" maxlength="1000" bindinput="updateContent"></textarea>
    </view>
    <view class="tit">添加图片</view>
    <view class="imgs">
      <view class="li" wx:for="{{imageUrls}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill"/>
        <view class="del" data-index="{{index}}" bindtap="del">
          <text class="iconfont icon-close"></text>
        </view>
      </view>
      <view wx:if="{{imageUrls.length < 3}}" class="li upload-btn" bindtap="chooseImage">
        <text class="iconfont icon-add"></text>
      </view>
    </view>
    
  </view>
  <view class="btn {{!title ? 'dis':''}}" bindtap="toIssue">去许愿</view>
</view>