<!--pages/createBlessing/index.wxml-->
<view>
  <view class="top">
    <view class="img">
      <image src="/image/bless.png" mode="aspectFit"/>
    </view>
  </view>
  <view class="edit">
    <view class="tit">祈福内容</view>
    <view class="edit-box">
      <input type="text" placeholder="标题：祝自己事业有成！" 	placeholder-class="placeholder"/>
    </view>
    <view class="edit-box">
      <textarea value="" placeholder="补充祈福内容\n如：为2025年的自己祈福\n1、不再为租房发愁；\n2、工资涨得比物价快；\n3、顺利脱单，找个伴一起嗨；" placeholder-class="placeholder"></textarea>
    </view>
    <view class="tit">添加图片</view>
    <view class="upload-btn">
      <text class="iconfont icon-add"></text>
    </view>
  </view>
  <view class="btn">发布祈福</view>
</view>