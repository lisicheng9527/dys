/* pages/blessing/index.wxss */
.blessing {
  padding: 118rpx 24rpx 140rpx;
}
.tab {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  display: flex;
  flex-direction: row;
  height: 88rpx;
  border-bottom: 1rpx solid #ddd;
  background: linear-gradient(to bottom, #F1DBBC, #FFFFFF);
}
.tab view{
  position: relative;
  margin-top: 30rpx;
  width: 50%;
  color: var(--themeColor);
  font-size: 32rpx;
  text-align: center;
}
.tab view.active {
  font-weight: bold;
}
.tab view.active::after {
  display: block;
  content: '';
  width: 66rpx;
  height: 2rpx;
  background: #B94433;
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-33rpx);
}
.user {
  display: flex;
  margin-bottom: 20rpx;
}
.user .avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-right: 10rpx;
}
.user .user-fr {
  height: 70rpx;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.user .user-fr .nickname {
  color: #000;
}
.user .user-fr .score {
  display: flex;
}
.user .user-fr .score .iconfont {
  font-size: 30rpx;
}
.user .user-fr .score view{
  margin-right: 20rpx;
}
.tit {
  font-size: 32rpx;
  color: #000;
  margin-bottom: 10rpx;
}
.con {
  color: #666;
  margin-bottom: 30rpx;
  font-size: 26rpx;
}
.imgs image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.icon-lotus {
  color: #B94433;
}
.icon-fourleaf {
  color: #56A20A;
}
.comment-tit {
  color: #3D231F;
  font-size: 32rpx;
  border-bottom: 1rpx solid #ddd;
  line-height: 68rpx;
  margin-bottom: 6rpx;
}
.comment-tit .iconfont {
  font-size: 36rpx;
}
.comment {
  font-size: 24rpx;
  padding: 22rpx 0;
  color: #333;
  line-height: 34rpx;
  border-bottom: 1rpx solid #ddd;
}
.comment .name {
  color: #666;
}
.reply { 
  margin-top: 10rpx;
  background: #F5F5F5;
  padding:14rpx 20rpx;
  border-radius: 16rpx;
}
.reply .li {
  line-height: 28rpx;
  font-size: 20rpx;
  margin: 4rpx 0;
}
.footer {
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  padding: 0 32rpx;
  background: #fff;
  align-items: center;
  font-size: 14px;
}
.footer .input {
  flex: 1;
}
.footer .input input{
  width: 100%;
}
.footer .icon-btn {
  width: 150rpx;
  color: var(--themeColor);
  text-align: center;
  height: 20px;
}
.footer .share {
  border-left: 1rpx solid #ddd;
}
