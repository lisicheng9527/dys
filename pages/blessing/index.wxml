<!--祈福详情-->
<view class="blessing">
  <view class="tab top-bg">
    <view class="{{tabIndex == 0 ? 'active': ''}}" bindtap="toggleTab" data-id="0">祈福内容</view>
    <view class="{{tabIndex == 1 ? 'active': ''}}"  bindtap="toggleTab" data-id="1"><text class="iconfont icon-comment" ></text>评论</view>
  </view>
  <view class="user" id="index0">
    <image class="avatar" src="{{detail.userInfo.headImgUrl}}"/>
    <view class="user-fr">
      <text class="nickname">{{detail.userInfo.nickname}}</text>
      <view class="score">
        <view>
          <text class="iconfont icon-lotus"></text>
          {{detail.userInfo.meritCount}}
        </view>
        <view>
          <text class="iconfont icon-fourleaf"></text>
          {{detail.userInfo.luckyCount}}
        </view>
      </view>
    </view>
  </view>
  <view class="tit">{{detail.title}}</view>
  <view class="con">{{detail.content}}</view>
  <view class="imgs" wx:if="{{detail.imageUrls && detail.imageUrls.length}}">
    <image wx:for="{{detail.imageUrls}}" wx:key="index" src="{{item}}" mode="widthFix"/>
  </view>
  <view class="comment-tit" id="index1">
    <text class="iconfont icon-comment"></text>
    评论（{{detail.commentCount}}）
  </view>
  <view class="comment" wx:for="{{comments}}" wx:key="index">
    <view class="li" data-id="{{item.commentId}}" data-index="{{index}}" bindtap="toReply">
      <text class="name">{{item.userInfo.nickname}}：</text>{{item.content}}
    </view>
    <!-- <text class="iconfont icon-love-plain fr" bindtap="toLikeComment"></text> -->
    <view class="tip more-tip" wx:if="{{item.replyCount && !item.isShowReplys}}" data-id="{{item.commentId}}" data-index="{{index}}" bindtap="getReply">
      <text class="line">——</text>展开{{item.replyCount}}条回复
      <text class="iconfont icon-arrow"></text>
    </view>
    <view class="reply" wx:if="{{item.isShowReplys}}">
      <view class="li" wx:for="{{item.replys}}" wx:for-item="reply" wx:key="commentId">
        <text class="name">{{reply.userInfo.nickname}}：</text>{{reply.content}}
      </view>
    </view>
    <view class="tip pack-tip" data-index="{{index}}" wx:if="{{item.replyCount && item.isShowReplys}}" bindtap="packReplys">
      <text class="line">——</text>收起
      <text class="iconfont icon-arrow"></text>
    </view>
  </view>
  <view class="footer">
    <view class="input">
      <input id="commentInput" focus="{{isFocus}}" type="text" placeholder="{{placeholder}}" bindinput="onInput" value="{{commentValue}}" confirm-type="send" 	bindconfirm="sendComment"/>
    </view>
    <view class="icon-btn wish" bindtap="likeBless">
      <text class="iconfont {{detail.wishStatus == 1 ? 'icon-love':'icon-love-plain'}}"></text>
      {{detail.wishCount}}
      <view class="tip-tag" wx:if="{{detail.wishCountAdd}}">功德+1</view>
    </view>
    <view class="icon-btn share">
      <text class="iconfont icon-share"></text>
      {{detail.forwardCount}}
      <button open-type="share"></button>
    </view>
  </view>
</view>