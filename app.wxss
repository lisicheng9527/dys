@import "./iconfont/iconfont.wxss";

page {
  --themeColor:#643C2C;
}

view {
  font-family: Arial, sans-serif;
}
.header {
  height: 40px;
  text-align: center;
  line-height: 40px;
  font-size: 20px;
  color: var(--themeColor);
  position: relative;
}

.btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 40rpx;
  color: #fff;
  border-radius: 200rpx;
  display: flex;
  justify-content: center;
  background-color: #B94433;
  position: relative;
}